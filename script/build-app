#!/bin/bash
# Builds "Trafficlight.app" (the menu bar app) from app/Trafficlight.swift into libexec/
# (or the folder given), with an icon drawn by the app itself.
#   script/build-app [out-dir] [--icon]   (--icon redraws assets/AppIcon.icns)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="${1:-$ROOT/libexec}"
APP="$OUT_DIR/Trafficlight.app"
VERSION="$(grep -m1 '^VERSION=' "$ROOT/bin/trafficlight" | cut -d'"' -f2)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

rm -rf "$APP"; mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
swiftc -O -parse-as-library -target "$(uname -m)-apple-macos13.0" \
  "$ROOT/app/Trafficlight.swift" -o "$APP/Contents/MacOS/Trafficlight"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Trafficlight</string>
  <key>CFBundleDisplayName</key><string>Trafficlight</string>
  <key>CFBundleIdentifier</key><string>app.trafficlight</string>
  <key>CFBundleExecutable</key><string>Trafficlight</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSUIElement</key><true/>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>app.trafficlight</string>
    <key>CFBundleURLSchemes</key><array><string>trafficlight</string></array>
  </dict></array>
</dict></plist>
PLIST

# The icon is drawn by the app and kept in assets/. --icon redraws it.
if [ "${2:-}" = "--icon" ] || [ ! -f "$ROOT/assets/AppIcon.icns" ]; then
  "$APP/Contents/MacOS/Trafficlight" --icon "$TMP/AppIcon.iconset"
  iconutil -c icns "$TMP/AppIcon.iconset" -o "$ROOT/assets/AppIcon.icns"
fi
cp "$ROOT/assets/AppIcon.icns" "$APP/Contents/Resources/AppIcon.icns"
codesign --force --deep -s - "$APP" >/dev/null 2>&1   # ad-hoc signature for local use
echo "built: $APP"
